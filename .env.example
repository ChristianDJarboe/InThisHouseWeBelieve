# =============================================================================
# InThisHouseWeBelieve — Environment Variables
# Copy this file to .env and fill in real values. Never commit .env.
# =============================================================================

# Server
PORT=3000
NODE_ENV=development
# Public URL of this app (used for Stripe success/cancel URLs and webhooks)
PUBLIC_URL=http://localhost:3000
# Client URL in dev (Vite); production usually same as PUBLIC_URL
CLIENT_URL=http://localhost:5173

# -----------------------------------------------------------------------------
# Stripe (https://dashboard.stripe.com/apikeys)
# Use test keys while developing. For webhooks locally: stripe listen --forward-to localhost:3000/api/webhooks/stripe
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Product pricing (cents) and display name shown in Checkout
PRODUCT_PRICE_CENTS=4999
PRODUCT_NAME=In This House We Believe Plastic Yard Sign

# -----------------------------------------------------------------------------
# Printify (https://printify.com/app/account/api)
# 1. Create API token
# 2. Note your Shop ID (Catalog → select shop, or GET /v1/shops.json)
# 3. Create / pick a blueprint product, then note:
#    - BLUEPRINT_ID, PRINT_PROVIDER_ID, VARIANT_ID from Printify catalog/product UI or API
# See README for step-by-step ID discovery.
# -----------------------------------------------------------------------------
PRINTIFY_API_TOKEN=
PRINTIFY_SHOP_ID=
PRINTIFY_BLUEPRINT_ID=
PRINTIFY_PRINT_PROVIDER_ID=
PRINTIFY_VARIANT_ID=

# Optional: max background image upload size in MB (default 5)
MAX_UPLOAD_MB=5
