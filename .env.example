# =============================================================================
# InThisHouseWeBelieve — Environment Variables
# Copy this file to .env and fill in real values. Never commit .env.
# =============================================================================

# Server
PORT=3000
NODE_ENV=development
# Public URL of this app (used for Stripe success/cancel URLs and webhooks)
PUBLIC_URL=http://localhost:3000
# Client URL in dev (Vite); production usually same as PUBLIC_URL
CLIENT_URL=http://localhost:5173

# -----------------------------------------------------------------------------
# Stripe (https://dashboard.stripe.com/apikeys)
# Use test keys while developing. For webhooks locally: stripe listen --forward-to localhost:3000/api/webhooks/stripe
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Product pricing — either set PRODUCT_SIZES_JSON (recommended) or fall back to code defaults.
# Each size maps to a Printify variant id for blueprint 1205 / provider 228 (Plastic Yard Sign).
# PRODUCT_PRICE_CENTS is only a legacy fallback; checkout uses the selected size price.
PRODUCT_PRICE_CENTS=4000
PRODUCT_NAME=In This House We Believe Plastic Yard Sign
PRODUCT_SIZES_JSON=[{"variantId":"92131","label":"18″ × 12″ Horizontal","priceCents":2999,"orientation":"horizontal"},{"variantId":"92132","label":"24″ × 18″ Horizontal","priceCents":3999,"orientation":"horizontal"},{"variantId":"92133","label":"36″ × 24″ Horizontal","priceCents":5499,"orientation":"horizontal"},{"variantId":"92134","label":"12″ × 18″ Vertical","priceCents":2999,"orientation":"vertical"},{"variantId":"92135","label":"18″ × 24″ Vertical","priceCents":3999,"orientation":"vertical"},{"variantId":"92136","label":"24″ × 36″ Vertical","priceCents":5499,"orientation":"vertical"}]

